---
import MarketingLayout from '../../layouts/MarketingLayout.astro';
// The stats backend is external (set PUBLIC_API_URL); rendered fully client-side.
const apiUrl = import.meta.env.PUBLIC_API_URL ?? 'https://api.frontmatter.codes';
---
<MarketingLayout title="Analytics" description="Front Matter usage analytics." showGetStarted={false}>
  <div class="container">
    <div class="page-header">
      <h1>Analytics</h1>
      <p>Usage statistics for the Front Matter extension.</p>
    </div>
    <div id="analytics" data-api={apiUrl}>
      <p id="analytics-status">Loading analytics…</p>
      <div id="analytics-charts"></div>
    </div>
  </div>
</MarketingLayout>

<style>
  .chart { margin: 2rem 0; }
  .chart h2 { font-size: 1.35rem; font-weight: 700; margin: 0 0 1rem; }
  .bar-row { display: grid; grid-template-columns: 12rem 1fr; align-items: center; gap: 0.75rem; margin: 0.35rem 0; }
  .bar-label { color: var(--whisper-700); font-size: 0.9rem; text-align: right; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .bar-track { background: var(--vulcan-300); border-radius: 0.25rem; overflow: hidden; }
  .bar-fill { background: var(--teal-500); color: var(--vulcan-500); font-weight: 600; font-size: 0.8rem; padding: 0.2rem 0.5rem; white-space: nowrap; border-radius: 0.25rem; min-width: 2rem; }
</style>

<script>
  const root = document.getElementById('analytics');
  const statusEl = document.getElementById('analytics-status');
  const chartsEl = document.getElementById('analytics-charts');
  const api = root?.getAttribute('data-api') || '';

  function toRows(obj: Record<string, number> | undefined) {
    if (!obj) return [] as Array<[string, number]>;
    return Object.entries(obj).sort((a, b) => b[1] - a[1]);
  }

  function renderChart(title: string, rows: Array<[string, number]>) {
    if (!rows.length) return '';
    const max = Math.max(...rows.map((r) => r[1])) || 1;
    const bars = rows
      .map(([label, value]) => {
        const pct = Math.max(2, Math.round((value / max) * 100));
        return `<div class="bar-row"><div class="bar-label" title="${label}">${label}</div>` +
          `<div class="bar-track"><div class="bar-fill" style="width:${pct}%">${value}</div></div></div>`;
      })
      .join('');
    return `<section class="chart"><h2>${title}</h2>${bars}</section>`;
  }

  async function load() {
    if (!api) {
      if (statusEl) statusEl.textContent = 'Analytics endpoint is not configured.';
      return;
    }
    try {
      const res = await fetch(`${api}/stats`);
      if (!res.ok) throw new Error(String(res.status));
      const data = await res.json();
      let html = '';
      if (data.activate) {
        html += renderChart('Activations — beta', toRows(data.activate.beta));
        html += renderChart('Activations — stable', toRows(data.activate.stable));
      }
      html += renderChart('Webviews', toRows(data.webviews));
      html += renderChart('Events', toRows(data.events));
      html += renderChart('Versions', toRows(data.versions));
      if (chartsEl) chartsEl.innerHTML = html;
      if (statusEl) statusEl.style.display = html ? 'none' : 'block';
      if (statusEl && !html) statusEl.textContent = 'No analytics data available.';
    } catch {
      if (statusEl) statusEl.textContent = 'Could not load analytics data.';
    }
  }

  load();
</script>
